# Copy to .env and fill only what you use. Never commit real secrets.

# Optional LLM planner. The default run does not call any model.
# Set GEO_FLOOD_LLM=1 or pass --llm. Scores still come from tools.
# OpenAI:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini
# Ollama on a Mac mini (OpenAI-compatible):
#   OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   OPENAI_API_KEY=ollama
#   OPENAI_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEO_FLOOD_LLM=0
# GEO_FLOOD_LLM_TIMEOUT=90
# GEO_FLOOD_CACHE=./.cache/geo_flood_agent

# Optional override for Open-Elevation (default public endpoint used if unset)
# OPEN_ELEVATION_URL=https://api.open-elevation.com/api/v1/lookup

# Runtime: demo | mock | live
GEO_FLOOD_MODE=demo
